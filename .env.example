# Public, canonical origin of the site. Used for canonical URLs, sitemap, OpenGraph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional server-side webhooks. When set, validated form submissions are forwarded here.
# Never expose these to the client (no NEXT_PUBLIC_ prefix).
EARLY_ACCESS_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
